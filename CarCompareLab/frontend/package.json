{
  "name": "car-compare-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "type-check": "vue-tsc -b",
    "build": "vue-tsc -b && vite build",
    "data:recalls": "node ./scripts/updateRecallData.mjs",
    "data:side-images": "node --experimental-strip-types ./scripts/syncVehicleActualSideImages.mjs",
    "data:side-image-names": "node --experimental-strip-types ./scripts/exportVehicleImageFileNames.mjs",
    "data:specs": "node ./scripts/updateVehicleSpecs.mjs",
    "preview": "vite preview",
    "preview:host": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
